+// Jesvi stores APFS at the start of super and HFSX at the start of userdata.
+static bool JesviHasMagic(const char* path, off_t offset, const char* magic, size_t size) {
+	char bytes[4];
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+	ssize_t got = pread(fd, bytes, size, offset);
+	close(fd);
+	return got == static_cast<ssize_t>(size) && memcmp(bytes, magic, size) == 0;
+}
+
+static bool jesvi_layout;
+
+static bool JesviAndroidMount(const std::string& mount) {
+	return mount == "/data" || mount == "/metadata" || mount == "/system" ||
+	       mount == "/system_root" || mount == "/vendor" || mount == "/product" ||
+	       mount == "/odm" || mount == "/system_ext" || mount == "/vendor_dlkm" ||
+	       mount == "/odm_dlkm";
 }
 
+static bool JesviSkipFstabLine(const char* line, bool flags) {
+	if (!jesvi_layout)
+		return false;
+	std::istringstream fields(line);
+	std::string first, second;
+	fields >> first >> second;
+	// Legacy TWRP entries and flags put the mount point first. Android fstab
+	// uses a block path or logical partition name in the first field.
+	return JesviAndroidMount(first) || (!flags && JesviAndroidMount(second)) ||
+	       (flags && (first == "/system_image" || first == "/vendor_image" ||
+	                  first == "/product_image" || first == "/odm_image"));
+}
